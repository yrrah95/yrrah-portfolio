  "narrative": {
    "northStar": "The Paper Archive（紙本索引卡）",
    "overview": "一個把 Threads 短貼文和 skill 清單整理成可以翻找的索引卡的網站。米色紙、細線、深墨色字，只有一種橘紅像印章一樣蓋在重要的數字和連結上。",
    "keyCharacteristics": [
      "暖米色（淺）與暖黑（深）兩套完整配色",
      "單一點綴色：橘紅",
      "平面為主，靠細線與底色差分層",
      "只用系統字，不載入網路字體",
      "固定字級階梯"
    ],
    "rules": [
      {
        "name": "The One Stamp Rule",
        "body": "橘紅出現的地方，是這一頁最值得看的東西。",
        "section": "colors"
      },
      {
        "name": "The Both Themes Rule",
        "body": "每個新顏色同時定義淺色與深色，走 token，文字對比度 4.5:1 以上。",
        "section": "colors"
      },
      {
        "name": "The No New Size Rule",
        "body": "想要新字級，先確認既有九階是否不夠。",
        "section": "typography"
      },
      {
        "name": "The Measure Rule",
        "body": "長文行寬限制在約 34em。",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "會對齊比較的數字一律 tabular-nums。",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "靜止時沒有陰影；只有浮動元件有。",
        "section": "elevation"
      }
    ],
    "dos": [
      "所有顏色走 token，淺深兩個值同時定義",
      "字級走 --fs-*、內容寬度走 --wrap",
      "互動元素的可點高度至少 40px",
      "長文加 text-wrap: pretty，標題加 balance",
      "同一個說法在整個網站只說一次"
    ],
    "donts": [
      "引入網路字體或第二個字族",
      "用 800 或 600 字重",
      "在元件裡寫死色碼或 px 字級",
      "用 kicker、漸層字、單側粗彩色邊框、巢狀卡片",
      "用陰影分層",
      "為了看起來完整而加說明字"
    ]
